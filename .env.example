# ==============================================================================
# PR-Sentinel Configuration Template
# Copy this file to .env and configure for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pr_sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pr_sentinel

# Redis (Caching & ARQ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# GitHub App Integration
# Obtain these from your GitHub App settings (Settings -> Developer Settings -> GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github_app_private_key.pem
# Alternatively, supply the base64-encoded private key string:
# GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# LLM Provider Configuration
# Supported providers: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (Set the key corresponding to your chosen LLM_PROVIDER)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security & Review Thresholds
DEFAULT_FAIL_ON_SEVERITY=HIGH
AUTO_REQUEST_CHANGES=true
BLOCK_PROHIBITED_LICENSES=true
PROHIBITED_LICENSES=["GPL-3.0", "AGPL-3.0", "SSPL-1.0"]

